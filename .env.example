# Copy to .env.local (gitignored) for local dev; mirror in Vercel project env.
# Only variable NAMES live here — never commit real values.

# --- Firebase web config (public by design; see PRD §12) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Spotify PKCE client id (public by design; no client secret is used) ---
# Shared by the (disabled) playlist export (PRD §13) and the personal play
# endpoint (PRD §14).
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# --- Personal "play my playlist" endpoint (PRD §14) — all SERVER-ONLY secrets ---
# Shared secret for POST /api/play (header x-play-secret) and for starting owner
# auth (?key=). Generate with: openssl rand -hex 32
PLAY_SECRET=
# Filled in AFTER running /api/spotify/owner-auth?key=<PLAY_SECRET> once.
SPOTIFY_OWNER_REFRESH_TOKEN=
# Spotify playlist to play: "spotify:playlist:<id>" or an open.spotify.com link.
SPOTIFY_PLAYLIST_URI=
# Device name to target (case-insensitive; substring ok), e.g. "iPhone".
# Falls back to any Smartphone, then the active device.
SPOTIFY_DEVICE_NAME=
# "true" to turn shuffle on before playing.
SPOTIFY_SHUFFLE=
